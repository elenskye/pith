{
  "name": "合成毕业论文排版规范（示例，不代表任何学校的真实要求）",
  "page": {
    "paper": "A4",
    "margins_cm": { "top": 2.54, "bottom": 2.54, "left": 3.17, "right": 3.17 },
    "header_cm": 1.5,
    "footer_cm": 1.75
  },
  "body": {
    "font_latin": "Times New Roman",
    "font_east_asia": "宋体",
    "size_pt": 12,
    "align": "both",
    "line_spacing": 1.5,
    "space_before_pt": 0,
    "space_after_pt": 0,
    "first_line_indent_chars": 2
  },
  "headings": [
    { "level": 1, "font_latin": "Times New Roman", "font_east_asia": "黑体", "size_pt": 16, "bold": true, "color": "000000", "align": "center", "line_spacing": 1.0, "space_before_pt": 24, "space_after_pt": 18, "first_line_indent_chars": 0 },
    { "level": 2, "font_latin": "Times New Roman", "font_east_asia": "黑体", "size_pt": 14, "bold": true, "color": "000000", "align": "left", "line_spacing": 1.0, "space_before_pt": 12, "space_after_pt": 6, "first_line_indent_chars": 0 },
    { "level": 3, "font_latin": "Times New Roman", "font_east_asia": "黑体", "size_pt": 12, "bold": true, "color": "000000", "align": "left", "line_spacing": 1.0, "space_before_pt": 6, "space_after_pt": 6, "first_line_indent_chars": 0 }
  ],
  "caption": { "font_latin": "Times New Roman", "font_east_asia": "黑体", "size_pt": 10.5, "align": "center", "line_spacing": 1.0, "first_line_indent_chars": 0 },
  "table_text": { "size_pt": 10.5, "align": "center", "line_spacing": 1.0, "first_line_indent_chars": 0 },
  "figure": { "align": "center", "line_spacing": 1.0, "first_line_indent_chars": 0 },
  "footnote": { "size_pt": 9, "align": "both", "line_spacing": 1.0, "first_line_indent_chars": 0 },
  "header_footer": { "font_latin": "Times New Roman", "font_east_asia": "宋体", "size_pt": 9 },
  "toc": { "size_pt": 12, "line_spacing": 1.5, "first_line_indent_chars": 0 },
  "code": { "style_names": ["代码", "Code", "Source Code"], "font_latin": "Menlo", "size_pt": 10, "align": "left", "line_spacing": 1.0, "first_line_indent_chars": 0 },
  "direct_formatting": { "strip_fonts": true, "strip_sizes": true, "strip_colors": true, "strip_paragraph_spacing": true },
  "update_fields_on_open": false
}
