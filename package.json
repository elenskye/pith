{
  "name": "pith",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "app:dev": "bash scripts/clean-build.sh --auto && tauri dev",
    "app:build": "bash scripts/clean-build.sh --auto && tauri build --bundles app",
    "app:install": "bash scripts/install-app.sh",
    "clean:build": "bash scripts/clean-build.sh",
    "check": "bash scripts/clean-build.sh --auto && mkdir -p dist && tsc --noEmit && node --test 'src/**/*.test.ts' && cargo test --workspace --quiet && pnpm --dir poc/word-addin check",
    "test:web": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "citeproc": "2.4.63",
    "lucide-react": "^1.48.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
