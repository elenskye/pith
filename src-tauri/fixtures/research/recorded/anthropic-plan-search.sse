event: content_block_delta
data: {"type":"content_block_delta","index":4,"delta":{"type":"text_delta","text":"{\"summary\":\"先看示例市官方口径的青年失业率、工资和求人倍率，再用独立调查和招聘平台的数据对照，最后和样本市比较。官方数字与其他来源的口径不同，比较时分开写。\",\"sub_questions\":[{\"text\":\"示例市 16–24 岁青年的调查失业率近几年是多少？\",\"metric\":\"16–24 岁城镇青年调查失业率\",\"definition\":\"城镇调查失业率，不含在校学生\",\"population\":\"16–24 岁城镇青年\",\"region\":\"示例市\",\"period\":\"2022–2024 年\",\"angle\":\"official\",\"source_types\":[\"统计局公报\",\"统计年鉴表格\",\"官方媒体\"],\"queries\":[\"示例市 青年失业率 统计公报\",\"示例市 16-24岁 调查失业率\"]},{\"text\":\"示例市城镇单位就业人员的平均工资是多少（非私营、私营）？\",\"metric\":\"城镇单位就业人员年平均工资\",\"definition\":\"分非私营单位、私营单位\",\"population\":\"城镇单位就业人员\",\"region\":\"示例市\",\"period\":\"2024 年\",\"angle\":\"official\",\"source_types\":[\"统计局公报\"],\"queries\":[\"示例市 2024 平均工资 非私营 私营\"]},{\"text\":\"示例市的求人倍率是多少？\",\"metric\":\"求人倍率\",\"definition\":\"公共就业服务机构的岗位数与求职人数之比\",\"population\":\"\",\"region\":\"示例市\",\"period\":\"2022–2024 年\",\"angle\":\"official\",\"source_types\":[\"人社部门数据\"],\"queries\":[\"示例市 求人倍率\"]},{\"text\":\"独立调查或学术研究估计的示例市青年失业率是多少？\",\"metric\":\"青年失业率（独立估计）\",\"definition\":\"看各自的口径，例如是否包含放弃找工作的人\",\"population\":\"16–24 岁青年\",\""}}

event: content_block_stop
