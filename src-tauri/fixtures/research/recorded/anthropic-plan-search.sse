event: content_block_delta
data: {"type":"content_block_delta","index":5,"delta":{"type":"text_delta","text":"region\":\"示例市\",\"period\":\"2024 年\",\"angle\":\"alternative\",\"source_types\":[\"高校与研究机构的调查\",\"独立调查机构\"],\"queries\":[\"示例市 青年就业调查 大学\"]},{\"text\":\"招聘平台上示例市的岗位数和招聘薪资是多少？\",\"metric\":\"新发布岗位数、平均招聘月薪\",\"definition\":\"平台自己的业务数据\",\"population\":\"\",\"region\":\"示例市\",\"period\":\"2024 年\",\"angle\":\"alternative\",\"source_types\":[\"招聘平台数据\"],\"queries\":[\"示例招聘 示例市 岗位数 薪资\"]},{\"text\":\"样本市同一口径的青年失业率是多少？\",\"metric\":\"16–24 岁城镇青年调查失业率\",\"definition\":\"城镇调查失业率\",\"population\":\"16–24 岁城镇青年\",\"region\":\"样本市\",\"period\":\"2024 年\",\"angle\":\"official\",\"source_types\":[\"统计局公报\"],\"queries\":[\"样本市 青年失业率 2024\"]}],\"alt_dimensions\":[{\"name\":\"独立调查与学术估计\",\"why\":\"口径由研究者自己定，可以检验官方调查失业率是否偏低\",\"sources\":\"高校、研究机构的抽样调查\"},{\"name\":\"招聘平台的岗位数与薪资\",\"why\":\"反映企业实际的招聘需求和开价，不依赖登记或调查口径\",\"sources\":\"招聘平台发布的季度数据\"},{\"name\":\"社保参保人数\",\"why\":\"反映有正式劳动关系的就业规模，可以和就业人员总数对照\",\"sources\":\"人社部门、社保基金年报\"}],\"caveats\":[\"城镇调查失业率不含在校学生，独立调查的宽口径把放弃找工作的人也算作失业，两者不能直接比大小。\",\"招聘平台的数据只覆盖在该平台招聘的企业。\",\"不同城市的统计公报发布时间不同，比较时要看是不是同一年。\"]}"}}

